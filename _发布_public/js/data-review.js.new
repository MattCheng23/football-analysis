        { no: "002", teams: "仁川 1-1 富川", league: "韩职", lg: "lg-k1", stats: "xG 1.71:1.05、射门 15:8、控球 70%:30%、禁区内触球 35:12、最佳=Morgan Ferrier 8.1", signal: "🟡 乌龙剧本+补时红牌（R327沾边）", txt: "45+3' Juan Ibiza（仁川后卫）乌龙0-1→84' Ferrier（助攻Chi-In Jung）1-1→90+4' Ji-Ho Han（富川）两黄变红，半场0-1；演戏排查：🟡 主队控球70%+射门15:8+xG 1.71:1.05占优却半场0-1（45+3'乌龙失球，R327沾边），84'才扳平；富川85'换上Han后90+2'黄牌90+4'两黄下场（补时红牌剧本）；控分排查：45+3'乌龙在上半场补时热点段（乌龙关键事件时机），84'扳平在75-90'热点段，总进球2球卡2.5线下（未跨线），补时红牌收尾，控分浓度中", sc: "watch" },
        { no: "003", teams: "光州 1-2 济州", league: "韩职", lg: "lg-k1", stats: "xG 1.37:2.41、射门 8:31、控球 42%:58%、禁区内触球 14:33、最佳=Jae-Hyeok Oh 8.7", signal: "🟡 补时绝杀跨2.5线（R328沾边）", txt: "10' Ji-Hoon Jeong（光州）1-0→42' Jae-Hyeok Oh（助攻Italo）1-1→56' Kyoung-Rok Choi（光州）红牌→90+2' Gi-Min Kwon（助攻Choi）1-2，半场1-1；演戏排查：🟡 垫底队光州（12名11分）10'领先后遭济州射门31:8碾压，56'红牌10人后90+2'被补时绝杀（R328收缩沾边；济州xG 2.41:1.37本应更早拿下）；控分排查：90+2'补时绝杀=滚球热门时段，1-1（2球）→1-2（3球）跨2.5线（补时跨线球），光州45+5'即少打一人仍守住1-1至90+2'，控分浓度中", sc: "ok" },
        { no: "004", teams: "安养 2-1 江原", league: "韩职", lg: "lg-k1", stats: "xG 1.82:2.40、射门 12:19、控球 39%:61%、禁区内触球 17:38、最佳=Ivan Jukic 8.6", signal: "🟡 补时跨线球（R328沾边）", txt: "3' Geon-Joo Choi（助攻Jukic）1-0→37' Herculano（助攻Jukic）2-0→90+6' Halaihal（助攻Dae-Won Kim）2-1，半场2-0；演戏排查：🟡 安养2-0领先后被江原90+6'补时追一球（R328领先收缩沾边；江原控球61%+射门19:12+xG 2.40:1.82占优，安养靠Jukic两助攻+门将Kim 7.9发挥取胜，最佳Jukic 8.6在赢球方无割裂）；控分排查：90+6'补时进球=滚球热门时段，2-0（2球）→2-1（3球）跨2.5线（补时跨线球），领先方2-0后未扩大也未失控至平局，控分浓度中", sc: "ok" },
        { no: "005", teams: "布洛马 1-1 哈马比", league: "瑞超", lg: "lg-swe", stats: "xG 0.31:1.89、射门 6:24、控球 35%:65%、禁区内触球 18:51、最佳=Victor Lind 8.2", signal: "🟡 占优被补时绝平（R327沾边）", txt: "79' Victor Lind（哈马比）0-1→90' Andreas Troelsen（助攻Kurochkin）1-1，半场0-0；演戏排查：🟡 哈马比客场碾压（xG 1.89:0.31、射门24:6、控球65%）79'领先后被主场90'补时绝平（R327占优被翻盘沾边；主队仅6射门xG 0.31却90'扳平）；控分排查：90'补时绝平=滚球热门时段，总进球1→2卡2.5线下（未跨线），79'领先到90'丢球间隔11分钟，控分浓度中低", sc: "ok" },

        { no: "009", teams: "布兰 2-3 瓦勒伦加", league: "挪超", lg: "lg-nor", stats: "xG 2.46:2.91、射门 16:19、控球 71%:29%、禁区内触球 45:29、最佳=Bjørdal 9.2", signal: "🟡 占优惨败+0-3半场（R327）", txt: "24' Bjørdal头球（助攻Ravn-Haren）0-1→41' Lange（助攻Ambina）0-2→45+4' Ravn-Haren（助攻Bjørdal）0-3→57' Näsberg（瓦勒伦加）红牌→65' Castro点球1-3→77' Horn Myhre（助攻De Roeve）2-3，半场0-3；演戏排查：🟡 主场布兰控球71%+射门16:19+xG 2.46:2.91占优却半场0-3（R327沾边；客队24'/41'/45+4'半场3球，57'红牌10人后守住2-3，布兰65'点球77'追至2-3后79'-90+7'未能再进）；控分排查：45+4'上半场补时第3球（热点段）+65'点球（0-3→1-3跨3.5线）+77'（1-3→2-3跨4.5线）65'-77'连跨两线，红牌后客队10人收缩，控分浓度中高", sc: "ok" },
        { no: "010", teams: "赫尔辛基 1-0 TPS图尔库", league: "芬超", lg: "lg-fin", stats: "控球 66%:34%、射门 13:11、射正 4:6、禁区内触球 23:15、最佳=Matej Markovic 8.1（主队门将）（xG数据待补）", signal: "正常", txt: "16' Santeri Haarala（赫尔辛基）1-0，半场1-0；演戏排查：无异常（1-0正常主胜，控球66%+射门13:11占优；客队射正6:4反超但主队门将Markovic 8.1高扑救+16'早进球后控场，无红牌/点球/补时剧本）；控分排查：16'唯一进球非热点时段，总进球1球卡2.5线下，无跨线球，控分浓度低", sc: "ok" },
        { no: "011", teams: "哥德堡盖斯 1-1 哈姆斯塔德", league: "瑞超", lg: "lg-swe", stats: "射门 17:6、射正 6:4、扑救 3:5（GAIS门将Krasniqi 3扑/客队门将Rönning 5扑，ESPN双源，控球/xG数据待补）", signal: "🟡 领先被补时点球绝平（R327沾边）", txt: "52' Henry Sletsjøe（盖斯）1-0→90+2' Rocco Ascone（哈姆斯塔德）点球1-1，半场0-0；演戏排查：🟡 盖斯主场射门17:6+射正6:4碾压垫底队（1胜4平9负7分）52'领先后90+2'被点球绝平（R327沾边；90+2'补时点球=领先方补时丢分；客队门将Rönning 5扑救为保平解释）；控分排查：90+2'补时点球=滚球热门时段+点球关键事件时机，总进球1→2卡2.5线下（未跨线），垫底队客场补时点球抢分，控分浓度中", sc: "watch" },
        { no: "012", teams: "马尔默 1-2 埃尔夫斯堡", league: "瑞超", lg: "lg-swe", stats: "xG 0.95:1.13、射门 12:9、控球 61%:39%、禁区内触球 37:15、最佳=Momoh Kamara 8.4", signal: "正常（三指标全中）", txt: "5' Zeneli（助攻Magnússon）0-1→22' Larsen（助攻Åstrand John）1-1→34' Kamara（助攻Zeneli）1-2→73' Malte Frejd Pålsson（马尔默）红牌，半场1-2；演戏排查：无异常（预测负命中；马尔默61%控球+射门12:9占优但xG 0.95:1.13落后+73'红牌10人，埃尔夫斯堡5'闪击34'再进后防守成功，主队10人无力回天，无补时/乌龙剧本）；控分排查：5'闪击（<25'热点）+34'进球，总进球3球跨2.5线（34'完成非尾声），73'红牌改变走势，无补时跨线球，控分浓度低", sc: "ok" },

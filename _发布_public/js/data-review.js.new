        { no: "002", teams: "町田泽维 3-1 浦和红钻", league: "日职联", lg: "lg-j1", stats: "控球 38%:62%、射门 13:22、射正 7:3、禁区触球 14:28、xG 1.15:2.37、大机会 2:6（错失 2:5）、角球 1:3、红牌 0:0、黄牌 0:1（83' Naganuma（客））（FotMob）", signal: "方向✅+比分✅（3-1 TOP2）+半全场✅（平胜TOP2）+总进球✅（4球 in 4·5）；🟡浦和占优惨败沾边（R327）", txt: "全场 3-1（半场 1-1）：8' Nakamura 1-0、45+1' Watanabe（客）1-1、54' Nishimura 2-1、60' Lavi 3-1（FotMob 事件流+ESPN 双源核验）。红牌 0:0；黄牌 客1（83' Naganuma）。预测 主胜（B级）2-1/3-1/4-1：**方向✅+比分✅（3-1 TOP2）+半全场✅（平胜TOP2，半场 1-1）+总进球✅（4 球 in 4·5）**；数据检查：🟡 浦和控球 62%/22 射/xG 2.37/大机会 6（错失 5）数据占优却 1-3（数据-结果割裂）；町田 7 射正进 3（43% 高效）+3 连胜状态旺为合理解释（浦和 6 大机会错失 5=真实低效+运气）；演戏排查：🟡 观察（浦和占优惨败 R327 沾边，单场信号，无补时剧本/无过山车不升级）；控分排查：进球时段 8'（开场段）+45+1'（半场前）+54'/60'（下半场开局）；60' 后 30 分钟无球=町田 3-1 锁定收手（常规）；总进球 4 球卡 3.5 线上（3-1 固定），浓度低", sc: "watch" },
        { no: "003", teams: "大田市民 3-0 江原FC", league: "韩职", lg: "lg-k1", stats: "控球 72%:28%、射门 9:4、射正 3:2、角球 2:0、红牌 0:1（43' Min-Woo Seo（客）直红）、黄牌 1:0（44' Soon-Min Lee（主））（FotMob；韩职无 xG）", signal: "方向❌+比分❌+半全场❌+总进球✅（3球 in 2·3）；🔴江原43'直红10人作战（真实劣势非演戏）", txt: "全场 3-0（半场 0-0）：47' Ludwigson 1-0、56' Min-Kyu Joo 2-0、66' Jae-Hee Jeong 3-0（FotMob 事件流+用户告知双源核验；ESPN K League 页 503 无法交叉，FotMob 为权威源）。红牌 0:1（43' Seo 直红，客队 10 人）；黄牌 主1（44' Soon-Min Lee）。预测 负（C级）0-1/1-2/0-2：**方向❌（实际主胜 3-0）+比分❌（3-0 未覆盖）+半全场❌（胜平 vs 平负/负负/胜负）+总进球✅（3 球 in 2·3）**；数据检查：江原 43' 直红=比赛转折（10v11 作战 47 分钟），大田 72% 控球+下半场 3 球=红牌后正常优势；R409 注解：预测未含打穿项（0-3 级）属红牌意外不可预知，不计规则失误；江原客场红牌崩盘（红牌+10 人=真实竞技因素）；演戏排查：✅ 无异常（红牌导致的崩盘非演戏；大田赢球=正路兑现，按避雷新标准大田黑分不追加）；控分排查：进球时段 47'/56'/66'（下半场中段密集=红牌后压上）；半场 0-0+下半场 3 球=总进球 3 球卡 2.5-3.5 线间（未跨 3.5），无补时剧本，浓度低", sc: "ok" },
        { no: "005", teams: "菲尔特 1-2 波鸿", league: "德国杯", lg: "lg-dfb", stats: "控球 65%:35%、射门 22:6、射正 4:3、禁区触球 39:8、xG 1.60:0.43、大机会 2:1、角球 11:1、红牌 0:0、黄牌 2:2（FotMob summary）", signal: "方向✅+比分✅（1-2 TOP1）+半全场✅（负负TOP2）+总进球✅（3球 in 3·4）；🟡菲尔特占优惨败沾边+波鸿0.43xG进2球", txt: "全场 1-2（半场 0-1）：25' Rasmussen（客）0-1、64' Hofmann（客）0-2、77' Dal（主）1-2（FotMob 事件流+ESPN 双源核验）。红牌 0:0；黄牌 2:2（FotMob summary）。预测 负（B级）1-2/1-3/0-3：**方向✅+比分✅（1-2 TOP1）+半全场✅（负负TOP2，半场 0-1）+总进球✅（3 球 in 3·4）**；数据检查：🟡 菲尔特 65% 控球/22 射/禁区触球 39:8/xG 1.60 全面占优却 1-2（R327 占优惨败沾边）+波鸿 xG 0.43 进 2 球（转化异常 R324 沾边）——德乙 vs 德甲杯赛首轮客队效率反击属单场波动合理区，波鸿 64' 即 0-2 领先 2 球、77' 菲尔特扳回 1 球=进程正常；演戏排查：🟡 观察（数据-结果割裂沾边，单场信号）；控分排查：进球时段 25'（上半场中段）+64'/77'（下半场中段）；无补时剧本；总进球 3 球卡 2.5-3.5 线间（2-1 固定），浓度低", sc: "watch" },
        { no: "009", teams: "曼城 2-1 伯恩茅斯", league: "英超", lg: "lg-eng", stats: "控球 66%:34%、射门 13:5、射正 6:4、禁区触球 37:6、xG 2.36:0.63、大机会 5:1（错失 4:0）、角球 8:3、红牌 0:0、黄牌 1:2（78' Foden（主）/45' Evanilson（客）/85' António Silva（客））（FotMob）", signal: "方向✅+比分✅（2-1 TOP1）+总进球✅（3球 in 2·3）；半全场❌（负胜非TOP3）；🟡84'+90+1'双跨线（R359豁免记过程戏剧性）", txt: "全场 2-1（半场 0-1）：26' Tavernier（客）0-1、84' Guéhi 1-1、90+1' Gvardiol 2-1（FotMob 事件流+ESPN 双源核验；ESPN 新闻 Two late goals save Man City blushes）。红牌 0:0；黄牌 主1（78' Foden）客2（45' Evanilson/85' António Silva）。预测 主胜/平（B级）2-1/1-1/2-0：**方向✅（主胜在双选）+比分✅（2-1 TOP1）+总进球✅（3 球 in 2·3）+半全场❌（实际负胜=半场 0-1 全场 2-1，预测胜胜/平胜/平平未覆盖逆转形态）**；数据检查：曼城 xG 2.36/禁区触球 37:6/大机会 5:1 全面碾压但伯恩茅斯 xG 0.63 进 1（效率 159%）=客队技术型领先被逆转；🟡 尾声双跨线（84' 1-1 由 2 球跨 2.5 线、90+1' 2-1 由 3 球跨 3.5 线）；演戏排查：🟡 观察（跨线球双发+弱队领先收缩 R328 沾边；按 R359 英超揭幕轮豁免——无积分利益演戏概率极低，记过程戏剧性不记嫌疑，sc=ok）；控分排查：进球时段 26'（上半场中段）+84'（75-90 热门段）+90+1'（补时）；总进球 3 球卡 2.5 线上（2-1 固定），曼城强攻 58 分钟才扳平=效率问题，浓度中（记档）", sc: "ok" },
